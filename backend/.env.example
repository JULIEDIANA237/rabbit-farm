# Connexion PostgreSQL (Neon ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rabbitfarm"
# Optionnel : connexion directe (non poolée), utilisée en priorité par PrismaService
# DATABASE_URL_UNPOOLED="postgresql://..."

# Secret de signature des JWT (chaîne longue et aléatoire)
JWT_SECRET="change-me"

# Port de l'API (le frontend attend http://localhost:3001/graphql)
PORT=3001

# Base utilisée par les tests d'intégration / e2e (sera vidée !)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rabbitfarm_test"

# Stockage des photos (Supabase Storage) — clé secrète côté serveur uniquement
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RABBIT_PHOTOS_BUCKET=rabbit-photos
