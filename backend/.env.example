# Connexion PostgreSQL (Neon ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rabbitfarm"
# Optionnel : connexion directe (non poolée), utilisée en priorité par PrismaService
# DATABASE_URL_UNPOOLED="postgresql://..."

# Secret de signature des JWT (chaîne longue et aléatoire)
JWT_SECRET="change-me"

# Port de l'API (le frontend attend http://localhost:3001/graphql)
PORT=3001

# Base utilisée par les tests d'intégration / e2e (sera vidée !)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rabbitfarm_test"

# Stockage des photos (Supabase Storage) — clé secrète côté serveur uniquement
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RABBIT_PHOTOS_BUCKET=rabbit-photos

# Adresses du frontend autorisées en production (séparées par des virgules)
# CORS_ORIGINS=https://rabbit-farm.vercel.app

# Assistant IA (optionnel : sans clé, l'assistant est simplement masqué)
# AI_PROVIDER=google            # google (Gemini, défaut) ou anthropic (Claude)
# GOOGLE_GENERATIVE_AI_API_KEY= # clé créée sur https://aistudio.google.com
# ANTHROPIC_API_KEY=            # si AI_PROVIDER=anthropic
# AI_MODEL=                     # défaut : gemini-flash-latest / claude-haiku-5-5
# AI_DAILY_LIMIT=150            # demandes IA maximum par ferme et par jour
# AI_TIMEOUT_MS=45000          # délai maximum d'une réponse IA (ms)
