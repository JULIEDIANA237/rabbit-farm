generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum FarmRole {
  ADMIN
  BREEDING_MANAGER
  EMPLOYEE
  VETERINARIAN
}

enum SectionType {
  REPRODUCTION
  MATERNITY
  FATTENING
  QUARANTINE
  OTHER
}

enum CageStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RabbitSex {
  MALE
  FEMALE
  UNKNOWN
}

enum RabbitStatus {
  ACTIVE
  SOLD
  DEAD
  TRANSFERRED
  CULLED
}

enum RabbitIdentificationType {
  TATTOO
  RING
  EAR_TAG
  OTHER
}

enum BreedingStatus {
  PLANNED
  AWAITING_PALPATION
  PREGNANT
  NON_PREGNANT
  INCONCLUSIVE
  BIRTH_RECORDED
  CANCELLED
}

enum PregnancyResult {
  PREGNANT
  NOT_PREGNANT
  INCONCLUSIVE
}

enum LitterStatus {
  ACTIVE
  WEANED
  CLOSED
}

enum AdoptionReason {
  EQUALIZATION
  SURPLUS
  ORPHAN
  MOTHER_REJECTED
  OTHER
}

enum FatteningLotStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum ExpenseCategory {
  FEED
  MEDICATION
  ENERGY
  EQUIPMENT
  MAINTENANCE
  TRANSPORT
  SALARY
  OTHER
}

enum InventoryItemType {
  FEED
  MEDICATION
  EQUIPMENT
  OTHER
}

/// Catégories de lapins pour le calcul des rations journalières.
enum FeedingCategory {
  PREGNANT
  LACTATING
  FATTENING
  MAINTENANCE
}

enum StockMovementType {
  INITIAL
  PURCHASE
  CONSUMPTION
  LOSS
  ADJUSTMENT
  RETURN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskSourceType {
  MANUAL
  BREEDING
  PREGNANCY
  BIRTH
  WEANING
  HEALTH
  SALE
  INVENTORY
  OTHER
}

enum HealthRecordType {
  OBSERVATION
  TREATMENT
  VACCINATION
  ANALYSIS
  CONTROL
}

enum InbreedingPolicy {
  WARN
  BLOCK
}

enum MortalityScope {
  RABBIT
  LITTER
  LOT
}

enum RabbitPurpose {
  BREEDER
  FATTENING
  FUTURE_BREEDER
  REFORM
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean @default(true)

  memberships FarmMembership[]

  healthRecordsCreated HealthRecord[] @relation("HealthRecordsCreated")

  assignedTasks Task[] @relation("AssignedTasks")

  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  appRating           AppRating?

  /// Dernière activité (mise à jour au plus une fois par heure).
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Lien de réinitialisation du mot de passe (on ne garde que l'empreinte du jeton).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Abonnement aux notifications du navigateur (rappels des tâches du jour).
model PushSubscription {
  id       String @id @default(uuid())
  userId   String
  farmId   String
  endpoint String @unique
  p256dh   String
  auth     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([farmId])
}

/// Nombre de demandes à l'assistant IA par ferme et par jour (limite quotidienne).
model AiUsage {
  farmId String
  day    String
  count  Int    @default(0)

  updatedAt DateTime @updatedAt

  @@id([farmId, day])
}

// ============================================================
// FARM
// ============================================================

model Farm {
  id          String  @id @default(uuid())
  name        String
  description String?
  location    String?

  /// Politique appliquée aux demi-frères/demi-sœurs
  /// et aux ancêtres communs éloignés (§18).
  inbreedingPolicy InbreedingPolicy @default(WARN)

  /// Assistant « bras droit » : questions de suivi et alertes au fil de la journée.
  companionEnabled   Boolean @default(true)
  /// Notifications de l'assistant par jour (en plus du rappel du matin), de 0 à 3.
  companionMaxPerDay Int     @default(3)
  /// Position de la ferme pour la météo (déduite du lieu saisi).
  latitude          Float?
  longitude         Float?
  geocodedLocation  String?
  companionQuestions CompanionQuestion[]

  /// Critères « prêt pour la vente » : âge minimum (jours) et poids minimum (kg).
  saleMinAgeDays  Int   @default(90)
  saleMinWeightKg Float @default(2.5)

  careRecords CareRecord[]

  memberships FarmMembership[]
  sections    Section[]
  cages       Cage[]

  breeds      Breed[]
  crossBreeds CrossBreed[]
  rabbits     Rabbit[]

  breedings   Breeding[]
  pregnancies Pregnancy[]
  births      Birth[]
  litters     Litter[]

  fatteningLots FatteningLot[]

  healthRecords HealthRecord[]

  customers Customer[]
  sales     Sale[]

  expenses       Expense[]
  inventoryItems InventoryItem[]
  feedRations    FeedRation[]
  tasks          Task[]

  adoptions LitterAdoption[]
  weanings  Weaning[]

  nestInstallations NestInstallation[]
  mortalities       MortalityRecord[]

  /// Fin de l'essai gratuit. Vide : date de création + durée d'essai réglée par la plateforme.
  trialEndsAt DateTime?
  /// Fin de la période payée (abonnement mensuel ou annuel).
  paidUntil   DateTime?
  /// Accès gratuit à vie, accordé par la propriétaire de l'app (ex. : le gérant de sa ferme).
  freeAccess  Boolean   @default(false)
  subscriptionPayments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ============================================================
// FARM MEMBERSHIP
// ============================================================

model FarmMembership {
  id     String   @id @default(uuid())
  userId String
  farmId String
  role   FarmRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, farmId])
  @@index([userId])
  @@index([farmId])
}

// ============================================================
// SECTION
// ============================================================

model Section {
  id          String      @id @default(uuid())
  farmId      String
  name        String
  type        SectionType
  description String?

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cages Cage[]

  careRecords CareRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
  @@index([type])
}

// ============================================================
// CAGE
// ============================================================

model Cage {
  id        String @id @default(uuid())
  farmId    String
  sectionId String

  code     String
  type     String?
  capacity Int
  status   CageStatus @default(ACTIVE)

  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  rabbitMovements RabbitCageMovement[]
  lotMovements    LotCageMovement[]

  careRecords CareRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([sectionId])
  @@index([status])
}

// ============================================================
// BREED
// ============================================================

model Breed {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  description String?

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rabbits Rabbit[]

  crossBreedsAsParentA CrossBreed[] @relation("CrossBreedParentA")
  crossBreedsAsParentB CrossBreed[] @relation("CrossBreedParentB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
}

// ============================================================
// CROSSBREED
// ============================================================

model CrossBreed {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  description String?

  parentBreedAId String
  parentBreedBId String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  parentBreedA Breed @relation("CrossBreedParentA", fields: [parentBreedAId], references: [id])
  parentBreedB Breed @relation("CrossBreedParentB", fields: [parentBreedBId], references: [id])

  rabbits Rabbit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
  @@index([parentBreedAId])
  @@index([parentBreedBId])
}

// ============================================================
// RABBIT

model Rabbit {
  id     String @id @default(uuid())
  farmId String
  code   String

  sex    RabbitSex
  status RabbitStatus @default(ACTIVE)

  purpose RabbitPurpose @default(FATTENING)

  breedId      String?
  crossBreedId String?

  fatherId String?
  motherId String?

  birthDate    DateTime?
  color        String?
  weight       Decimal?
  observations String?

  /// Code temporaire d'origine (ex. L001-07) conservé
  /// lorsque le lapin reçoit son identité définitive (§12).
  originalCode String?

  /// Sortie de l'élevage (décès, réforme...)
  exitDate  DateTime?
  exitCause String?

  /// Passé du lapin à son arrivée (questions posées à la création).
  origin           String?
  previousLitters  Int?
  previousKitsBorn Int?
  lastBirthDate    DateTime?
  /// GOOD, AVERAGE ou POOR
  maternalBehavior String?
  previousMatings  Int?
  healthHistory    String?
  /// Lapereaux perdus et cas de cannibalisme avant l'enregistrement (femelle).
  previousKitsLost Int?
  cannibalismCases Int?
  /// Femelles différentes déjà saillies avant l'enregistrement (mâle).
  previousFemales  Int?

  /// Choisi à la main par l'éleveur pour la vente.
  readyForSale   Boolean   @default(false)
  readyForSaleAt DateTime?

  careRecords CareRecord[]

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  breed      Breed?      @relation(fields: [breedId], references: [id])
  crossBreed CrossBreed? @relation(fields: [crossBreedId], references: [id])

  father Rabbit? @relation("RabbitFather", fields: [fatherId], references: [id])
  mother Rabbit? @relation("RabbitMother", fields: [motherId], references: [id])

  childrenAsFather Rabbit[] @relation("RabbitFather")
  childrenAsMother Rabbit[] @relation("RabbitMother")

  photos RabbitPhoto[]

  identifications RabbitIdentification[]
  cageMovements   RabbitCageMovement[]

  adoptionHistory AdoptionRabbit[]

  weaningHistory WeaningRabbit[]

  tasks Task[]

  breedingsAsFemale Breeding[] @relation("FemaleBreedings")
  breedingsAsMale   Breeding[] @relation("MaleBreedings")
  extraMatings      BreedingMating[]

  motherBirths  Birth[]  @relation("MotherBirths")
  motherLitters Litter[] @relation("MotherLitters")
  fatherLitters Litter[] @relation("FatherLitters")

  birthLitterId String?
  birthLitter   Litter? @relation(fields: [birthLitterId], references: [id], onDelete: SetNull)

  lotMemberships LotMembership[]
  weighings      Weighing[]
  healthRecords  HealthRecord[]
  saleItems      SaleItem[]
  mortalities    MortalityRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([fatherId])
  @@index([motherId])
  @@index([breedId])
  @@index([crossBreedId])
  @@index([birthLitterId])
}

model RabbitPhoto {
  id        String   @id @default(uuid())
  rabbitId  String
  url       String
  path      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rabbit Rabbit @relation(fields: [rabbitId],references: [id],onDelete: Cascade)

  @@index([rabbitId])
}

// ============================================================
// RabbitIdentification
// ============================================================

model RabbitIdentification {
  id        String                   @id @default(uuid())
  rabbitId  String
  type      RabbitIdentificationType
  value     String
  isPrimary Boolean                  @default(false)

  rabbit Rabbit @relation(fields: [rabbitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rabbitId, type, value])
  @@index([rabbitId])
  @@index([type, value])
}

// ============================================================
// RabbitCageMovement
// ============================================================

model RabbitCageMovement {
  id String @id @default(uuid())

  rabbitId String
  cageId   String

  startedAt DateTime
  endedAt   DateTime?

  reason      String?
  observation String?

  rabbit Rabbit @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
  cage   Cage   @relation(fields: [cageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rabbitId])
  @@index([cageId])
  @@index([startedAt])
  @@index([endedAt])
}

model Breeding {
  id String @id @default(uuid())

  farmId   String
  femaleId String
  maleId   String

  breedingDate DateTime

  palpationStartDate DateTime?
  palpationEndDate   DateTime?

  nestDate DateTime?

  expectedBirthStartDate DateTime?
  expectedBirthEndDate   DateTime?

  status      BreedingStatus @default(PLANNED)
  observation String?

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  female Rabbit @relation("FemaleBreedings", fields: [femaleId], references: [id])
  male   Rabbit @relation("MaleBreedings", fields: [maleId], references: [id])

  /// Saillies supplémentaires du même jour (la première est breedingDate / maleId).
  matings BreedingMating[]

  pregnancies      Pregnancy[]
  birth            Birth?
  litters          Litter[]
  nestInstallation NestInstallation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([femaleId])
  @@index([maleId])
  @@index([breedingDate])
  @@index([status])
}

model Pregnancy {
  id String @id @default(uuid())

  breedingId String
  checkDate  DateTime

  result      PregnancyResult
  observation String?

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmId    String

  @@index([farmId])
  @@index([breedingId])
  @@index([checkDate])
  @@index([result])
}

model Birth {
  id String @id @default(uuid())

  breedingId String
  motherId   String

  birthDate DateTime

  liveBorn  Int
  stillBorn Int

  observation String?

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)
  mother   Rabbit   @relation("MotherBirths", fields: [motherId], references: [id])

  litter Litter?

  createdAt DateTime @default(now())
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmId    String

  @@unique([breedingId])
  @@index([farmId])
  @@index([motherId])
  @@index([birthDate])
}

model Litter {
  id String @id @default(uuid())

  farmId String
  code   String

  breedingId String?
  birthId    String? @unique

  motherId String
  fatherId String?

  birthDate DateTime

  liveBorn     Int
  stillBorn    Int
  currentCount Int
  observation  String?

  status LitterStatus @default(ACTIVE)

  mother Rabbit  @relation("MotherLitters", fields: [motherId], references: [id])
  father Rabbit? @relation("FatherLitters", fields: [fatherId], references: [id])

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  breeding Breeding? @relation(fields: [breedingId], references: [id], onDelete: SetNull)
  birth    Birth?    @relation(fields: [birthId], references: [id], onDelete: SetNull)

  rabbits Rabbit[]

  sourceAdoptions      LitterAdoption[]  @relation("SourceLitterAdoptions")
  destinationAdoptions LitterAdoption[]  @relation("DestinationLitterAdoptions")
  weanings             Weaning[]
  mortalities          MortalityRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([motherId])
  @@index([fatherId])
  @@index([breedingId])
  @@index([birthId])
  @@index([birthDate])
  @@index([status])
}

model LitterAdoption {
  id     String @id @default(uuid())
  farmId String

  sourceLitterId      String
  destinationLitterId String

  adoptedAt DateTime
  quantity  Int

  reason      String?
  observation String?

  farm              Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sourceLitter      Litter @relation("SourceLitterAdoptions", fields: [sourceLitterId], references: [id])
  destinationLitter Litter @relation("DestinationLitterAdoptions", fields: [destinationLitterId], references: [id])

  rabbits AdoptionRabbit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([sourceLitterId])
  @@index([destinationLitterId])
  @@index([adoptedAt])
}

model AdoptionRabbit {
  id         String @id @default(uuid())
  adoptionId String
  rabbitId   String

  adoption LitterAdoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  rabbit   Rabbit         @relation(fields: [rabbitId], references: [id])

  createdAt DateTime @default(now())

  @@unique([adoptionId, rabbitId])
  @@index([adoptionId])
  @@index([rabbitId])
}

model Weaning {
  id       String @id @default(uuid())
  farmId   String
  litterId String

  plannedDate DateTime
  actualDate  DateTime?

  quantity Int

  totalWeight   Decimal?
  averageWeight Decimal?

  observation String?

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  litter Litter @relation(fields: [litterId], references: [id], onDelete: Cascade)

  rabbits WeaningRabbit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([litterId])
  @@index([plannedDate])
  @@index([actualDate])
}

model WeaningRabbit {
  id        String @id @default(uuid())
  weaningId String
  rabbitId  String

  weight Decimal?

  weaning Weaning @relation(fields: [weaningId], references: [id], onDelete: Cascade)
  rabbit  Rabbit  @relation(fields: [rabbitId], references: [id])

  createdAt DateTime @default(now())

  @@unique([weaningId, rabbitId])
  @@index([weaningId])
  @@index([rabbitId])
}

model FatteningLot {
  id String @id @default(uuid())

  farmId String
  code   String

  entryDate DateTime
  exitDate  DateTime?

  status FatteningLotStatus @default(ACTIVE)

  observation String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  memberships LotMembership[]

  weighings     Weighing[]
  cageMovements LotCageMovement[]
  mortalities   MortalityRecord[]
  saleItems     SaleItem[]

  careRecords CareRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([status])
  @@index([entryDate])
}

model LotMembership {
  id String @id @default(uuid())

  lotId    String
  rabbitId String

  joinedAt DateTime
  leftAt   DateTime?

  reason String?

  lot    FatteningLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  rabbit Rabbit       @relation(fields: [rabbitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lotId])
  @@index([rabbitId])
  @@index([joinedAt])
  @@index([leftAt])
}

model Weighing {
  id String @id @default(uuid())

  rabbitId String?
  lotId    String?

  date DateTime

  totalWeight Float

  animalCount   Int
  averageWeight Float?

  ageInDays Int?

  observation String?

  rabbit Rabbit?       @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
  lot    FatteningLot? @relation(fields: [lotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rabbitId])
  @@index([lotId])
  @@index([date])
}

model HealthRecord {
  id String @id @default(uuid())

  farmId   String
  rabbitId String

  type HealthRecordType @default(OBSERVATION)

  date DateTime

  symptoms    String?
  observation String?
  suspicion   String?
  diagnosis   String?

  treatment  String?
  medication String?
  dosage     String?

  nextDueDate DateTime?

  createdById String?

  farm      Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rabbit    Rabbit @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("HealthRecordsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([farmId])
  @@index([rabbitId])
  @@index([date])
  @@index([nextDueDate])
}

model Customer {
  id String @id @default(uuid())

  farmId String

  name    String
  phone   String?
  email   String?
  address String?
  notes   String?

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([phone])
}

model Sale {
  id String @id @default(uuid())

  farmId     String
  customerId String?

  saleDate DateTime

  totalAmount Decimal

  status SaleStatus @default(UNPAID)

  observation String?

  farm     Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items    SaleItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id String @id @default(uuid())

  saleId   String
  rabbitId String?

  description String

  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal

  /// Vente au poids (§41) : poids total vendu et prix au kilo.
  weightKg   Float?
  pricePerKg Decimal?

  /// Vente d'un lot d'engraissement complet.
  lotId String?

  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  rabbit Rabbit?       @relation(fields: [rabbitId], references: [id], onDelete: SetNull)
  lot    FatteningLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([rabbitId])
  @@index([lotId])
}

model Payment {
  id String @id @default(uuid())

  saleId String

  amount      Decimal
  paymentDate DateTime

  method PaymentMethod

  reference   String?
  observation String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([paymentDate])
  @@index([method])
}

model Expense {
  id String @id @default(uuid())

  farmId String

  category ExpenseCategory
  amount   Decimal
  date     DateTime

  description String?
  reference   String?
  supplier    String?

  paymentMethod PaymentMethod?
  observation   String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([category])
  @@index([date])
}

model InventoryItem {
  id String @id @default(uuid())

  farmId String

  name String
  type InventoryItemType

  unit String

  currentStock Float  @default(0)
  minimumStock Float?

  /// Prix unitaire de référence (dernier prix d'achat ou saisi).
  unitPrice Decimal?

  /// Conditionnement d'achat : ex. « sac » de 25 (unités de stock, kg).
  packageName String?
  packageSize Float?

  /// Date jusqu'à laquelle les rations journalières ont été déduites du stock.
  rationsAppliedUntil DateTime?

  rations FeedRation[]

  description String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
  @@index([type])
}

model StockMovement {
  id String @id @default(uuid())

  inventoryItemId String

  type StockMovementType

  quantity Float
  date     DateTime

  unitCost Decimal?

  reference   String?
  description String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([date])
}

model Task {
  id String @id @default(uuid())

  farmId String

  title       String
  description String?

  rabbitId String?

  dueDate DateTime

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)

  assignedToId String?

  sourceType TaskSourceType?
  sourceId   String?

  /// Clé des tâches générées automatiquement (ex. BREEDING_PALPATION),
  /// utilisée pour les retrouver et les clôturer.
  automationKey String?

  completedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  assignedTo User? @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  rabbit Rabbit? @relation(fields: [rabbitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([rabbitId])
  @@index([sourceType, sourceId])
  @@index([automationKey])
}

// ============================================================
// INSTALLATION DU NID (§25)
// ============================================================

model NestInstallation {
  id String @id @default(uuid())

  farmId     String
  breedingId String @unique

  installedAt DateTime
  nestType    String?
  material    String?
  observation String?

  farm     Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([installedAt])
}

// ============================================================
// MORTALITÉ (§37)
// ============================================================

model MortalityRecord {
  id String @id @default(uuid())

  farmId String
  scope  MortalityScope

  rabbitId String?
  litterId String?
  lotId    String?

  date  DateTime
  count Int      @default(1)

  cause       String?
  observation String?

  farm   Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rabbit Rabbit?       @relation(fields: [rabbitId], references: [id], onDelete: SetNull)
  litter Litter?       @relation(fields: [litterId], references: [id], onDelete: SetNull)
  lot    FatteningLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([farmId])
  @@index([date])
  @@index([rabbitId])
  @@index([litterId])
  @@index([lotId])
}

// ============================================================
// LOT CAGE MOVEMENT (§57)
// ============================================================

model LotCageMovement {
  id String @id @default(uuid())

  lotId  String
  cageId String

  startedAt DateTime
  endedAt   DateTime?

  reason      String?
  observation String?

  lot  FatteningLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  cage Cage         @relation(fields: [cageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lotId])
  @@index([cageId])
  @@index([startedAt])
  @@index([endedAt])
}

// ============================================================
// RATIONS JOURNALIÈRES
// ============================================================

/// Quantité d'un aliment donnée chaque jour à UN lapin d'une catégorie
/// (dans l'unité de l'article, ex. kg).
model FeedRation {
  id String @id @default(uuid())

  farmId          String
  inventoryItemId String
  category        FeedingCategory

  dailyQuantity Float

  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryItemId, category])
  @@index([farmId])
}

// ============================================================
// SOINS (saisis librement par l'éleveur)
// ============================================================

enum CareScope {
  FARM
  SECTION
  CAGE
  LOT
  RABBIT
}

model CareRecord {
  id     String @id @default(uuid())
  farmId String

  date DateTime
  /// Libellé libre : Nettoyage, Vermifuge, Vitamines…
  careType String

  scope     CareScope @default(FARM)
  sectionId String?
  cageId    String?
  lotId     String?
  rabbitId  String?

  product     String?
  dose        String?
  animalCount Int?
  notes       String?

  nextDate DateTime?

  createdById String?

  farm    Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  section Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  cage    Cage?         @relation(fields: [cageId], references: [id], onDelete: SetNull)
  lot     FatteningLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  rabbit  Rabbit?       @relation(fields: [rabbitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([date])
}

// ============================================================
// SAILLIES SUPPLÉMENTAIRES D'UN MÊME ACCOUPLEMENT
// ============================================================

/// Une femelle peut être saillie plusieurs fois le même jour : chaque
/// saillie en plus s'ajoute à l'accouplement au lieu d'en créer un autre.
model BreedingMating {
  id         String   @id @default(uuid())
  breedingId String
  maleId     String
  date       DateTime

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)
  male     Rabbit   @relation(fields: [maleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([breedingId])
  @@index([maleId, date])
}

// ============================================================
// NOTE DE L'APPLICATION
// ============================================================

/// Note donnée par un utilisateur (une par personne, modifiable).
model AppRating {
  id      String  @id @default(uuid())
  userId  String  @unique
  farmId  String?
  stars   Int
  comment String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ABONNEMENT
// ============================================================

/// Réglages de l'abonnement, modifiables depuis la page propriétaire (une seule ligne, id « default »).
model PlatformSetting {
  id                  String   @id @default("default")
  trialDays           Int      @default(30)
  monthlyPrice        Int      @default(2500)
  yearlyPrice         Int      @default(25000)
  /// Comment payer (numéro Mobile Money, nom du compte…), affiché sur l'écran d'abonnement.
  paymentInstructions String?
  updatedAt           DateTime @updatedAt
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Paiement d'abonnement : déclaré par l'élevage, confirmé par la propriétaire.
model SubscriptionPayment {
  id            String                    @id @default(uuid())
  farmId        String
  farm          Farm                      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan
  amount        Int
  status        SubscriptionPaymentStatus @default(PENDING)
  /// Référence de la transaction Mobile Money donnée par l'éleveur.
  reference     String?
  requestedById String?
  /// Fin de la période payée une fois confirmé.
  periodEnd     DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime                  @default(now())
  /// Paiement en ligne : « NOTCHPAY » (null = déclaré à la main).
  provider      String?
  /// Identifiant de la transaction chez le prestataire (ex. pay_…).
  providerRef   String?                   @unique
  /// Page de paiement du prestataire.
  checkoutUrl   String?

  @@index([farmId])
  @@index([status])
}

/// Message envoyé depuis la zone contact de la page d'accueil (public).
model ContactMessage {
  id      String  @id @default(uuid())
  name    String
  contact String
  message String
  handled Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

enum AgentSuggestionStatus {
  PENDING
  DONE
  DISMISSED
  EXPIRED
}

/// Action proposée par l'agent de la propriétaire, en attente de sa validation.
model AgentSuggestion {
  id         String                @id @default(uuid())
  /// Clé stable : une même situation ne crée qu'une proposition (ignorée = reste ignorée).
  key        String                @unique
  kind       String
  severity   String
  title      String
  detail     String?
  href       String?
  /// NONE | CONFIRM_PAYMENT | EXTEND_TRIAL | SEND_EMAIL | REPLY_CONTACT
  action     String
  targetId   String?
  recipient  String?
  subject    String?
  draft      String?
  status     AgentSuggestionStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Journal de l'agent : ce qu'il a proposé ou fait, et ce que la propriétaire a validé.
model AgentLog {
  id           String  @id @default(uuid())
  /// AGENT ou OWNER
  actor        String
  actorEmail   String?
  action       String
  summary      String
  suggestionId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Point du matin rédigé pour la propriétaire.
model AgentBrief {
  id      String  @id @default(uuid())
  text    String
  usedAi  Boolean @default(false)
  pending Int     @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Erreurs inattendues du serveur, comptées par l'agent.
model AppError {
  id      String @id @default(uuid())
  source  String
  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// ASSISTANT « BRAS DROIT » DE L'ÉLEVEUR
// ============================================================

enum CompanionQuestionStatus {
  PENDING
  ANSWERED
  DISMISSED
  EXPIRED
}

/// Question ou alerte posée par l'assistant au fil de la journée.
model CompanionQuestion {
  id     String @id @default(uuid())
  farmId String
  /// Clé stable (ex. TREAT:<soin>:1) : une même situation ne crée qu'une question.
  key    String
  kind   String
  /// danger | warning | info
  severity String
  title    String
  detail   String?
  rabbitId String?
  refId    String?
  /// Réponses proposées : [{ value, label, tone?, href?, snoozeDays?, effect? }]
  options  Json
  adviceKey String?
  href      String?

  askAt      DateTime
  expiresAt  DateTime?
  notifiedAt DateTime?

  status       CompanionQuestionStatus @default(PENDING)
  answer       String?
  answerLabel  String?
  answeredById String?
  answeredAt   DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, key])
  @@index([farmId, status, askAt])
  @@index([notifiedAt])
}
