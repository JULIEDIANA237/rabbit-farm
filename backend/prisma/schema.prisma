generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum FarmRole {
  ADMIN
  BREEDING_MANAGER
  EMPLOYEE
  VETERINARIAN
}

enum SectionType {
  REPRODUCTION
  MATERNITY
  FATTENING
  QUARANTINE
  OTHER
}

enum CageStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RabbitSex {
  MALE
  FEMALE
  UNKNOWN
}

enum RabbitStatus {
  ACTIVE
  SOLD
  DEAD
  TRANSFERRED
  CULLED
}

enum RabbitIdentificationType {
  TATTOO
  RING
  EAR_TAG
  OTHER
}

enum BreedingStatus {
  PLANNED
  AWAITING_PALPATION
  PREGNANT
  NON_PREGNANT
  INCONCLUSIVE
  BIRTH_RECORDED
  CANCELLED
}

enum PregnancyResult {
  PREGNANT
  NOT_PREGNANT
  INCONCLUSIVE
}

enum LitterStatus {
  ACTIVE
  WEANED
  CLOSED
}

enum AdoptionReason {
  EQUALIZATION
  SURPLUS
  ORPHAN
  MOTHER_REJECTED
  OTHER
}

enum FatteningLotStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum ExpenseCategory {
  FEED
  MEDICATION
  EQUIPMENT
  MAINTENANCE
  TRANSPORT
  SALARY
  OTHER
}

enum InventoryItemType {
  FEED
  MEDICATION
  EQUIPMENT
  OTHER
}

enum StockMovementType {
  INITIAL
  PURCHASE
  CONSUMPTION
  LOSS
  ADJUSTMENT
  RETURN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean @default(true)

  memberships FarmMembership[]

  healthRecordsCreated HealthRecord[] @relation("HealthRecordsCreated")

  assignedTasks Task[] @relation("AssignedTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================================
// FARM
// ============================================================

model Farm {
  id          String  @id @default(uuid())
  name        String
  description String?
  location    String?

  memberships FarmMembership[]
  sections    Section[]
  cages       Cage[]

  breeds      Breed[]
  crossBreeds CrossBreed[]
  rabbits     Rabbit[]

  breedings   Breeding[]
  pregnancies Pregnancy[]
  births      Birth[]
  litters     Litter[]

  fatteningLots FatteningLot[]

  healthRecords HealthRecord[]

  customers Customer[]
  sales     Sale[]

  expenses       Expense[]
  inventoryItems InventoryItem[]
  tasks          Task[]

  adoptions LitterAdoption[]
  weanings  Weaning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ============================================================
// FARM MEMBERSHIP
// ============================================================

model FarmMembership {
  id     String   @id @default(uuid())
  userId String
  farmId String
  role   FarmRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, farmId])
  @@index([userId])
  @@index([farmId])
}

// ============================================================
// SECTION
// ============================================================

model Section {
  id          String      @id @default(uuid())
  farmId      String
  name        String
  type        SectionType
  description String?

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cages Cage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
  @@index([type])
}

// ============================================================
// CAGE
// ============================================================

model Cage {
  id        String @id @default(uuid())
  farmId    String
  sectionId String

  code     String
  type     String?
  capacity Int
  status   CageStatus @default(ACTIVE)

  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  rabbitMovements RabbitCageMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([sectionId])
  @@index([status])
}

// ============================================================
// BREED
// ============================================================

model Breed {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  description String?

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rabbits Rabbit[]

  crossBreedsAsParentA CrossBreed[] @relation("CrossBreedParentA")
  crossBreedsAsParentB CrossBreed[] @relation("CrossBreedParentB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
}

// ============================================================
// CROSSBREED
// ============================================================

model CrossBreed {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  description String?

  parentBreedAId String
  parentBreedBId String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  parentBreedA Breed @relation("CrossBreedParentA", fields: [parentBreedAId], references: [id])
  parentBreedB Breed @relation("CrossBreedParentB", fields: [parentBreedBId], references: [id])

  rabbits Rabbit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
  @@index([parentBreedAId])
  @@index([parentBreedBId])
}

// ============================================================
// RABBIT


model Rabbit {
  id     String @id @default(uuid())
  farmId String
  code   String

  sex    RabbitSex
  status RabbitStatus @default(ACTIVE)

  breedId      String?
  crossBreedId String?

  fatherId String?
  motherId String?

  birthDate    DateTime?
  color        String?
  weight       Decimal?
  observations String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  breed      Breed?      @relation(fields: [breedId], references: [id])
  crossBreed CrossBreed? @relation(fields: [crossBreedId], references: [id])

  father Rabbit? @relation("RabbitFather", fields: [fatherId], references: [id])
  mother Rabbit? @relation("RabbitMother", fields: [motherId], references: [id])

  childrenAsFather Rabbit[] @relation("RabbitFather")
  childrenAsMother Rabbit[] @relation("RabbitMother")

  identifications RabbitIdentification[]
  cageMovements   RabbitCageMovement[]

  adoptionHistory AdoptionRabbit[]

  weaningHistory WeaningRabbit[]

  breedingsAsFemale Breeding[] @relation("FemaleBreedings")
  breedingsAsMale   Breeding[] @relation("MaleBreedings")

  motherBirths  Birth[]  @relation("MotherBirths")
  motherLitters Litter[] @relation("MotherLitters")
  fatherLitters Litter[] @relation("FatherLitters")

  birthLitterId String?
  birthLitter   Litter? @relation(fields: [birthLitterId], references: [id], onDelete: SetNull)

  lotMemberships LotMembership[]
  weighings      Weighing[]
  healthRecords  HealthRecord[]
  saleItems      SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([fatherId])
  @@index([motherId])
  @@index([breedId])
  @@index([crossBreedId])
  @@index([birthLitterId])
}

// ============================================================
// RabbitIdentification
// ============================================================

model RabbitIdentification {
  id        String                   @id @default(uuid())
  rabbitId  String
  type      RabbitIdentificationType
  value     String
  isPrimary Boolean                  @default(false)

  rabbit Rabbit @relation(fields: [rabbitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rabbitId, type, value])
  @@index([rabbitId])
  @@index([type, value])
}

// ============================================================
// RabbitCageMovement
// ============================================================

model RabbitCageMovement {
  id String @id @default(uuid())

  rabbitId String
  cageId   String

  startedAt DateTime
  endedAt   DateTime?

  reason      String?
  observation String?

  rabbit Rabbit @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
  cage   Cage   @relation(fields: [cageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rabbitId])
  @@index([cageId])
  @@index([startedAt])
  @@index([endedAt])
}

model Breeding {
  id String @id @default(uuid())

  farmId   String
  femaleId String
  maleId   String

  breedingDate DateTime

  palpationStartDate DateTime?
  palpationEndDate   DateTime?

  nestDate DateTime?

  expectedBirthStartDate DateTime?
  expectedBirthEndDate   DateTime?

  status      BreedingStatus @default(PLANNED)
  observation String?

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  female Rabbit @relation("FemaleBreedings", fields: [femaleId], references: [id])
  male   Rabbit @relation("MaleBreedings", fields: [maleId], references: [id])

  pregnancies Pregnancy[]
  birth       Birth?
  litters     Litter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([femaleId])
  @@index([maleId])
  @@index([breedingDate])
  @@index([status])
}

model Pregnancy {
  id String @id @default(uuid())

  breedingId String
  checkDate  DateTime

  result      PregnancyResult
  observation String?

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  farm      Farm?    @relation(fields: [farmId], references: [id])
  farmId    String?

  @@unique([breedingId])
  @@index([breedingId])
  @@index([checkDate])
  @@index([result])
}

model Birth {
  id String @id @default(uuid())

  breedingId String
  motherId   String

  birthDate DateTime

  liveBorn  Int
  stillBorn Int

  observation String?

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)
  mother   Rabbit   @relation("MotherBirths", fields: [motherId], references: [id])

  litter Litter?

  createdAt DateTime @default(now())
  farm      Farm?    @relation(fields: [farmId], references: [id])
  farmId    String?

  @@unique([breedingId])
  @@index([motherId])
  @@index([birthDate])
}

model Litter {
  id String @id @default(uuid())

  farmId String
  code   String

  breedingId String?
  birthId    String? @unique

  motherId String
  fatherId String?

  birthDate DateTime

  liveBorn     Int
  stillBorn    Int
  currentCount Int
  observation  String?

  status LitterStatus @default(ACTIVE)

  mother Rabbit  @relation("MotherLitters", fields: [motherId], references: [id])
  father Rabbit? @relation("FatherLitters", fields: [fatherId], references: [id])

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  breeding Breeding? @relation(fields: [breedingId], references: [id], onDelete: SetNull)
  birth    Birth?    @relation(fields: [birthId], references: [id], onDelete: SetNull)

  rabbits Rabbit[]

  sourceAdoptions      LitterAdoption[] @relation("SourceLitterAdoptions")
  destinationAdoptions LitterAdoption[] @relation("DestinationLitterAdoptions")
  weanings             Weaning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([motherId])
  @@index([fatherId])
  @@index([breedingId])
  @@index([birthId])
  @@index([birthDate])
  @@index([status])
}

model LitterAdoption {
  id     String @id @default(uuid())
  farmId String

  sourceLitterId      String
  destinationLitterId String

  adoptedAt DateTime
  quantity  Int

  reason      String?
  observation String?

  farm              Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sourceLitter      Litter @relation("SourceLitterAdoptions", fields: [sourceLitterId], references: [id])
  destinationLitter Litter @relation("DestinationLitterAdoptions", fields: [destinationLitterId], references: [id])

  rabbits AdoptionRabbit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([sourceLitterId])
  @@index([destinationLitterId])
  @@index([adoptedAt])
}

model AdoptionRabbit {
  id         String @id @default(uuid())
  adoptionId String
  rabbitId   String

  adoption LitterAdoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  rabbit   Rabbit         @relation(fields: [rabbitId], references: [id])

  createdAt DateTime @default(now())

  @@unique([adoptionId, rabbitId])
  @@index([adoptionId])
  @@index([rabbitId])
}

model Weaning {
  id       String @id @default(uuid())
  farmId   String
  litterId String

  plannedDate DateTime
  actualDate  DateTime?

  quantity Int

  totalWeight   Decimal?
  averageWeight Decimal?

  observation String?

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  litter Litter @relation(fields: [litterId], references: [id], onDelete: Cascade)

  rabbits WeaningRabbit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([litterId])
  @@index([plannedDate])
  @@index([actualDate])
}

model WeaningRabbit {
  id        String @id @default(uuid())
  weaningId String
  rabbitId  String

  weight Decimal?

  weaning Weaning @relation(fields: [weaningId], references: [id], onDelete: Cascade)
  rabbit  Rabbit  @relation(fields: [rabbitId], references: [id])

  createdAt DateTime @default(now())

  @@unique([weaningId, rabbitId])
  @@index([weaningId])
  @@index([rabbitId])
}

model FatteningLot {
  id String @id @default(uuid())

  farmId String
  code   String

  entryDate DateTime
  exitDate  DateTime?

  status FatteningLotStatus @default(ACTIVE)

  observation String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  memberships LotMembership[]

  weighings Weighing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([status])
  @@index([entryDate])
}

model LotMembership {
  id String @id @default(uuid())

  lotId    String
  rabbitId String

  joinedAt DateTime
  leftAt   DateTime?

  reason String?

  lot    FatteningLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  rabbit Rabbit       @relation(fields: [rabbitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lotId])
  @@index([rabbitId])
  @@index([joinedAt])
  @@index([leftAt])
}

model Weighing {
  id String @id @default(uuid())

  rabbitId String?
  lotId    String?

  date DateTime

  totalWeight Float

  animalCount   Int
  averageWeight Float?

  ageInDays Int?

  observation String?

  rabbit Rabbit?       @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
  lot    FatteningLot? @relation(fields: [lotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rabbitId])
  @@index([lotId])
  @@index([date])
}

model HealthRecord {
  id String @id @default(uuid())

  farmId   String
  rabbitId String

  date DateTime

  symptoms    String?
  observation String?
  suspicion   String?
  diagnosis   String?

  treatment  String?
  medication String?
  dosage     String?

  nextDueDate DateTime?

  createdById String?

  farm      Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rabbit    Rabbit @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("HealthRecordsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([farmId])
  @@index([rabbitId])
  @@index([date])
  @@index([nextDueDate])
}

model Customer {
  id String @id @default(uuid())

  farmId String

  name    String
  phone   String?
  email   String?
  address String?
  notes   String?

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([phone])
}

model Sale {
  id String @id @default(uuid())

  farmId     String
  customerId String?

  saleDate DateTime

  totalAmount Decimal

  status SaleStatus @default(UNPAID)

  observation String?

  farm     Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items    SaleItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id String @id @default(uuid())

  saleId   String
  rabbitId String?

  description String

  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal

  sale   Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  rabbit Rabbit? @relation(fields: [rabbitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([rabbitId])
}

model Payment {
  id String @id @default(uuid())

  saleId String

  amount      Decimal
  paymentDate DateTime

  method PaymentMethod

  reference   String?
  observation String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([paymentDate])
  @@index([method])
}

model Expense {
  id String @id @default(uuid())

  farmId String

  category ExpenseCategory
  amount   Decimal
  date     DateTime

  description String?
  reference   String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([category])
  @@index([date])
}

model InventoryItem {
  id String @id @default(uuid())

  farmId String

  name String
  type InventoryItemType

  unit String

  minimumStock Float?

  description String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, name])
  @@index([farmId])
  @@index([type])
}

model StockMovement {
  id String @id @default(uuid())

  inventoryItemId String

  type StockMovementType

  quantity Float
  date     DateTime

  unitCost Decimal?

  reference   String?
  description String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([date])
}

model Task {
  id String @id @default(uuid())

  farmId String

  title       String
  description String?

  dueDate DateTime

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)

  assignedToId String?

  sourceType String?
  sourceId   String?

  completedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  assignedTo User? @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([sourceType, sourceId])
}
